---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}

// Normalize paths for comparison (remove trailing slashes)
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const targetPath = url.replace(/\/$/, "");

// Active if paths are identical, or if it is a subpath of a section (excluding homepages)
const isActive = currentPath === targetPath || 
                 (targetPath !== "" && targetPath !== "/en" && targetPath !== "/es" && currentPath.startsWith(targetPath + "/"));
---

<a
  href={url}
  data-astro-prefetch
  class={`relative inline-flex items-center justify-center rounded-full px-4 py-2 md:py-2.5 text-sm font-bold transition-all duration-300 outline-hidden whitespace-nowrap group md:text-sm 2xl:text-base ${
    isActive
      ? "text-primary-800 bg-white/60 dark:text-primary-300 dark:bg-white/10 shadow-[0_2px_10px_rgba(0,0,0,0.05),inset_0_1px_1px_rgba(255,255,255,0.8)] dark:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] border border-white/50 dark:border-white/10 backdrop-blur-md scale-105"
      : "text-neutral-700 hover:text-primary-700 hover:bg-white/40 dark:text-neutral-300 dark:hover:text-primary-300 dark:hover:bg-white/5 hover:shadow-sm border border-transparent hover:border-white/40 dark:hover:border-white/10 hover:scale-105"
  }`}
  aria-current={isActive ? "page" : undefined}
>
  <span class="relative z-10">{name}</span>
  {!isActive && <div class="absolute inset-0 rounded-full bg-gradient-to-r from-transparent via-white/40 dark:via-white/5 to-transparent opacity-0 group-hover:opacity-100 blur-sm transition-opacity duration-500"></div>}
</a>

