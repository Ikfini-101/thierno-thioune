---
import MainLayout from "@/layouts/MainLayout.astro";
import profImage from "@assets/images/TT_UEMOA.png";
---

<MainLayout title="Profil et Parcours | Professeur Thierno Thioune" lang="fr">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid md:grid-cols-3 gap-8 items-start">
      <div class="md:col-span-1">
        <img class="rounded-xl shadow-lg w-full object-cover" src={profImage.src} alt="Professeur Thierno Thioune UEMOA" />
      </div>
      <div class="md:col-span-2">
        <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 sm:text-4xl mb-4">
          Professeur Thierno Thioune
        </h1>
        <p class="text-xl text-primary-600 font-medium mb-6">
          Agrégé des Facultés d'Economie à l'UCAD
        </p>
        
        <div class="space-y-6 text-lg text-neutral-600 dark:text-neutral-400">
          <p>
            Le Professeur Thierno Thioune est un chercheur et universitaire de renom, 
            spécialiste des questions de développement économique, de macroéconomie et 
            de politiques publiques.
          </p>
          <p>
            Il est Professeur Titulaire à la Faculté des Sciences Économiques et de Gestion (FASEG) 
            de l'Université Cheikh Anta Diop de Dakar (UCAD).
          </p>
          <p>
            Ancien Directeur du Centre de Recherches Économiques Appliquées (CREA), il a mené 
            de nombreuses études sur l'intégration économique (CEDEAO, UEMOA), les inégalités de revenus, 
            et la vulnérabilité économique en Afrique Subsaharienne.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-8">Parcours et Expériences</h2>
      
      <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-neutral-300 before:to-transparent dark:before:via-neutral-700">
        
        <!-- Timeline Item 1 -->
        <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-neutral-200 group-[.is-active]:bg-primary-500 text-neutral-500 group-[.is-active]:text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 dark:bg-neutral-800 dark:border-neutral-900">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl border border-neutral-200 bg-white shadow-sm dark:border-neutral-700 dark:bg-neutral-800">
            <div class="flex items-center justify-between mb-1">
              <div class="font-bold text-neutral-800 dark:text-neutral-200">Professeur Titulaire et Agrégé</div>
            </div>
            <div class="text-sm font-medium text-primary-500 mb-2">UCAD - FASEG</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">Enseignement, recherche, et encadrement doctoral.</div>
          </div>
        </div>

        <!-- Timeline Item 2 -->
        <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-neutral-200 text-neutral-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 dark:bg-neutral-800 dark:border-neutral-900">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl border border-neutral-200 bg-white shadow-sm dark:border-neutral-700 dark:bg-neutral-800">
            <div class="flex items-center justify-between mb-1">
              <div class="font-bold text-neutral-800 dark:text-neutral-200">Directeur</div>
            </div>
            <div class="text-sm font-medium text-primary-500 mb-2">Centre de Recherches Économiques Appliquées (CREA)</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">Direction des études et des recherches stratégiques sur l'économie africaine.</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</MainLayout>
