---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const publications = await getCollection("publications");

// Sort by year descending
publications.sort((a, b) => b.data.year - a.data.year);
---

<MainLayout title="Publications | Professeur Thierno Thioune" lang="fr">
  <!-- Ambient background for glass effect -->
  <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary-300/30 dark:bg-primary-900/20 blur-[100px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-blue-300/30 dark:bg-blue-900/20 blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14 relative z-0">
    <div class="mb-10 max-w-2xl text-center mx-auto">
      <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 sm:text-4xl">
        Publications Scientifiques
      </h1>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
        Découvrez les articles, recherches et contributions du Professeur Thierno Thioune.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-1 lg:grid-cols-2">
      {publications.map((pub) => (
        <div class="flex flex-col rounded-3xl border border-white/80 dark:border-white/10 bg-white/50 dark:bg-black/30 p-7 backdrop-blur-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04),inset_0_1px_1px_rgba(255,255,255,1),inset_0_-1px_1px_rgba(255,255,255,0.3)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.4),inset_0_1px_1px_rgba(255,255,255,0.1)] transition-all duration-300 hover:-translate-y-1 hover:bg-white/70 dark:hover:bg-black/40 relative overflow-hidden group">
          
          <!-- Liquid shine sweep effect on hover -->
          <div class="absolute top-0 -inset-full h-full w-1/2 z-0 block transform -skew-x-12 bg-gradient-to-r from-transparent via-white/40 to-transparent opacity-0 group-hover:animate-shine group-hover:opacity-100 dark:via-white/5"></div>

          <div class="mb-4 flex items-center justify-between relative z-10">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/70 dark:bg-black/40 border border-white/50 dark:border-white/10 px-3 py-1 text-xs font-semibold text-primary-800 dark:text-primary-300 shadow-sm backdrop-blur-md">
              {pub.data.theme || "Recherche"}
            </span>
            <span class="text-sm font-bold text-neutral-500 dark:text-neutral-400">{pub.data.year}</span>
          </div>
          <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 relative z-10 leading-snug">
            {pub.data.title}
          </h3>
          <p class="mt-4 text-sm text-neutral-700 dark:text-neutral-300 relative z-10">
            <span class="font-bold text-neutral-900 dark:text-white">Auteurs :</span> {pub.data.authors}
          </p>
          <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300 relative z-10">
            <span class="font-bold text-neutral-900 dark:text-white">Revue :</span> {pub.data.journal} {pub.data.volume ? `(${pub.data.volume})` : ''}
          </p>
          
          <div class="mt-5 text-sm text-neutral-600 dark:text-neutral-400 line-clamp-4 relative z-10 leading-relaxed">
            {pub.body}
          </div>

          <div class="mt-auto pt-8 flex flex-wrap gap-3 relative z-10">
            {pub.data.link && (
              <a href={pub.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-x-2 rounded-2xl bg-primary-500/90 dark:bg-primary-600/80 px-6 py-2.5 text-sm font-bold text-white shadow-[0_4px_12px_rgba(0,0,0,0.1),inset_0_1px_1px_rgba(255,255,255,0.3)] backdrop-blur-md transition-all hover:bg-primary-600 hover:shadow-[0_6px_16px_rgba(0,0,0,0.15),inset_0_1px_1px_rgba(255,255,255,0.4)] hover:-translate-y-0.5">
                Lien / DOI
              </a>
            )}
            {pub.data.pdf && (
              <a href={pub.data.pdf} target="_blank" class="inline-flex items-center justify-center gap-x-2 rounded-2xl border border-white/60 dark:border-white/10 bg-white/50 dark:bg-white/5 px-6 py-2.5 text-sm font-bold text-neutral-800 dark:text-white shadow-[0_4px_12px_rgba(0,0,0,0.05),inset_0_1px_1px_rgba(255,255,255,0.8)] dark:shadow-none backdrop-blur-md transition-all hover:bg-white/80 dark:hover:bg-white/10 hover:shadow-[0_6px_16px_rgba(0,0,0,0.08),inset_0_1px_1px_rgba(255,255,255,1)] hover:-translate-y-0.5">
                Télécharger PDF
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</MainLayout>
